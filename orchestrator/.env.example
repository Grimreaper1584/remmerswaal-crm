# Copy to .env (never commit the real file) and fill in real values.
# Loaded via `set -a; source .env; set +a` or a process manager / cron
# wrapper — this script does not load .env itself (see README).

# --- CRM ---------------------------------------------------------------
CRM_API_URL=http://localhost:3000
CRM_API_KEY=change-me-to-the-same-value-as-INTERNAL_API_KEY-in-the-crm-env

# --- GVM connection ------------------------------------------------------
# "socket" (preferred) or "tls" (fallback if the gvmd unix socket isn't
# reachable from wherever this script runs).
GVM_CONNECTION_TYPE=socket
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock

# Only used when GVM_CONNECTION_TYPE=tls:
# GVM_HOST=127.0.0.1
# GVM_PORT=9390
# GVM_CA_CERT_PATH=/path/to/ca.pem
# GVM_CERT_PATH=/path/to/client-cert.pem
# GVM_KEY_PATH=/path/to/client-key.pem

# GMP authentication (required for both socket and TLS connections)
GVM_USERNAME=admin
GVM_PASSWORD=change-me

# Name filters used to look up UUIDs dynamically (never hardcoded).
# Defaults match the Greenbone Community Edition stock objects.
GVM_SCANNER_NAME_FILTER=OpenVAS
GVM_PORT_LIST_NAME_FILTER=All IANA

LOG_LEVEL=INFO
